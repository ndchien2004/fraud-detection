<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.frauddetection</groupId>
    <artifactId>fraud-detection-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Realtime Fraud Detection</name>

    <modules>
        <module>common</module>
        <module>tx-simulator</module>
        <module>feature-service</module>
        <module>scoring-service</module>
        <module>decision-api</module>
        <module>dashboard</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- keep in sync with onnxruntime in model-training/requirements.txt -->
        <onnxruntime.version>1.30.0</onnxruntime.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.frauddetection</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Gatling load test, kept out of the normal build and of the Docker images:
             .\mvnw.cmd -Pload-test -pl load-test gatling:test -->
        <profile>
            <id>load-test</id>
            <modules>
                <module>load-test</module>
            </modules>
        </profile>
    </profiles>
</project>
